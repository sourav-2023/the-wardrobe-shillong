{%- comment -%} Hero Slideshow Section {%- endcomment -%}

<section class="hero-slideshow" data-slideshow>
  <div class="hero-slideshow__slides">
    {%- for block in section.blocks -%}
      <div class="hero-slideshow__slide {% if forloop.first %}hero-slideshow__slide--active{% endif %}" {{ block.shopify_attributes }} data-slide="{{ forloop.index0 }}">
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1920 }}"
            alt="{{ block.settings.heading | escape }}"
            width="1920"
            height="auto"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            class="hero-slideshow__image"
          >
        {%- else -%}
          <div class="hero-slideshow__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
        <div class="hero-slideshow__content">
          {%- if block.settings.subheading != blank -%}
            <p class="hero-slideshow__subheading">{{ block.settings.subheading }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="hero-slideshow__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link }}" class="hero-slideshow__button btn">
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero-slideshow__controls">
      <button class="hero-slideshow__prev" aria-label="Previous slide" data-slide-prev>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="hero-slideshow__counter">
        <span data-slide-current>1</span> / <span>{{ section.blocks.size }}</span>
      </div>
      <button class="hero-slideshow__next" aria-label="Next slide" data-slide-next>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero slideshow",
  "class": "section-hero-slideshow",
  "max_blocks": 5,
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s",
      "label": "Autoplay speed"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "YOUR HOME"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "FOR PREMIUM SNEAKERS & APPAREL"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "See Collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "subheading": "YOUR HOME",
            "heading": "FOR PREMIUM SNEAKERS & APPAREL",
            "button_label": "See Collection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
