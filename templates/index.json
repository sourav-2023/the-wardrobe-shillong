{
  "sections": {
    "hero": {
      "type": "hero-slideshow",
      "blocks": {
        "slide_1": {
          "type": "slide",
          "settings": {
            "subheading": "YOUR HOME",
            "heading": "FOR PREMIUM SNEAKERS & APPAREL",
            "button_label": "See Collection"
          }
        },
        "slide_2": {
          "type": "slide",
          "settings": {
            "subheading": "NEW ARRIVALS",
            "heading": "LATEST DROP",
            "button_label": "Shop Now"
          }
        }
      },
      "block_order": ["slide_1", "slide_2"],
      "settings": {
        "autoplay_speed": 5
      }
    },
    "featured_collection": {
      "type": "featured-collection",
      "settings": {
        "title": "Limited Pieces",
        "products_to_show": 4,
        "columns": "4",
        "show_view_all": true
      }
    },
    "featured_product": {
      "type": "featured-product",
      "settings": {
        "show_shipping_note": true,
        "shipping_note": "Free Shipping + Get upto 30% OFF today"
      }
    },
    "image_with_text": {
      "type": "image-with-text",
      "settings": {
        "heading": "Top Picks"
      }
    },
    "second_collection": {
      "type": "featured-collection",
      "settings": {
        "title": "New Arrivals",
        "products_to_show": 4,
        "columns": "4",
        "show_view_all": true
      }
    },
    "marquee": {
      "type": "marquee-banner",
      "blocks": {
        "text_1": { "type": "text", "settings": { "text": "FREE SHIPPING" } },
        "text_2": { "type": "text", "settings": { "text": "RS.200 OFF TODAY" } },
        "text_3": { "type": "text", "settings": { "text": "LIMITED PIECES LEFT" } },
        "text_4": { "type": "text", "settings": { "text": "NO RESTOCKING" } },
        "text_5": { "type": "text", "settings": { "text": "EXCLUSIVE DROP" } }
      },
      "block_order": ["text_1", "text_2", "text_3", "text_4", "text_5"]
    },
    "testimonials": {
      "type": "testimonials",
      "settings": {
        "heading": "See what our customers said"
      },
      "blocks": {
        "review_1": {
          "type": "testimonial",
          "settings": {
            "name": "Happy Customer",
            "text": "Amazing quality! Highly recommended.",
            "rating": 5
          }
        }
      },
      "block_order": ["review_1"]
    }
  },
  "order": [
    "hero",
    "featured_collection",
    "featured_product",
    "image_with_text",
    "second_collection",
    "marquee",
    "testimonials"
  ]
}
